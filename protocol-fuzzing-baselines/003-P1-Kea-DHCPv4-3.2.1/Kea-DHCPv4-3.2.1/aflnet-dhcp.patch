+/* A DHCPv4 UDP datagram is one complete fuzzing message. Keep malformed
+   datagrams intact so Kea, rather than the adapter, handles their structure. */
+region_t* extract_requests_dhcp(unsigned char* buf, unsigned int buf_size, unsigned int* region_count_ref)
+{
+  if (buf_size == 0) {
+    *region_count_ref = 0;
+    return NULL;
+  }
+
+  region_t *regions = (region_t *)ck_alloc(sizeof(region_t));
+  regions[0].start_byte = 0;
+  regions[0].end_byte = buf_size - 1;
+  regions[0].modifiable = 1;
+  regions[0].state_sequence = NULL;
+  regions[0].state_count = 0;
+  *region_count_ref = 1;
+  return regions;
+}
