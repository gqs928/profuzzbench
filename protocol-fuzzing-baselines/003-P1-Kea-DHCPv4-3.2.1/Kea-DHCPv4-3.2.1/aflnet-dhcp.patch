+/* Use BOOTP operation and DHCP message type (option 53) as stable state
+   feedback. The option walk is bounded and tolerates malformed responses. */
+unsigned int* extract_response_codes_dhcp(unsigned char* buf, unsigned int buf_size, unsigned int* state_count_ref)
+{
+  if (buf_size == 0) {
+    *state_count_ref = 0;
+    return NULL;
+  }
+
+  unsigned int *state_sequence = (unsigned int *)ck_alloc(2 * sizeof(unsigned int));
+  state_sequence[0] = 0;
+
+  unsigned int state_code = 0x10000 | buf[0];
+  if (buf_size >= 240 && buf[236] == 99 && buf[237] == 130 &&
+      buf[238] == 83 && buf[239] == 99) {
+    unsigned int offset = 240;
+    unsigned int message_type = 0;
+    while (offset < buf_size) {
+      unsigned int option = buf[offset++];
+      if (option == 255) break;
+      if (option == 0) continue;
+      if (offset >= buf_size) break;
+      unsigned int option_length = buf[offset++];
+      if (option_length > buf_size - offset) break;
+      if (option == 53 && option_length == 1) message_type = buf[offset];
+      offset += option_length;
+    }
+
+    if (buf[0] == 2) {
+      state_code = message_type ? (0x20000 | message_type) : 0x20000;
+    } else if (message_type) {
+      state_code = 0x10000 | message_type;
+    }
+  }
+
+  state_sequence[1] = state_code;
+  *state_count_ref = 2;
+  return state_sequence;
+}
