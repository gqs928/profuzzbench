ARG BASE_IMAGE=kea-dhcp4-aflnet:3.2.1
FROM ${BASE_IMAGE}

ARG MAKE_JOBS=2
COPY aflnet-local-port.patch /tmp/aflnet-local-port.patch
RUN patch --binary --dry-run -p1 -d /opt/aflnet < /tmp/aflnet-local-port.patch \
    && patch --binary -p1 -d /opt/aflnet < /tmp/aflnet-local-port.patch \
    && AFL_NO_X86=1 make -C /opt/aflnet -j${MAKE_JOBS} afl-fuzz
