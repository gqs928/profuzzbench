diff --git a/CMakeLists.txt b/CMakeLists.txt
index d635a02..4ba6534 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1526,6 +1526,16 @@ else()
     add_library(open62541-object OBJECT ${lib_sources} ${lib_headers} ${exported_headers})
     add_library(open62541-plugins OBJECT ${plugin_sources} ${plugin_headers})
 endif()
+
+# open62541's event-loop callbacks intentionally cross typedef-compatible
+# callback interfaces that Clang's UBSan function check reports as mismatches.
+# Keep the other undefined-behavior checks and AddressSanitizer enabled for
+# fuzzing, while disabling this noisy check on the library objects.
+if(UA_BUILD_FUZZING AND CMAKE_C_COMPILER_ID MATCHES "Clang")
+    target_compile_options(open62541-object PRIVATE -fno-sanitize=function)
+    target_compile_options(open62541-plugins PRIVATE -fno-sanitize=function)
+endif()
+
 add_library(open62541 $<TARGET_OBJECTS:open62541-object> $<TARGET_OBJECTS:open62541-plugins>)
 
 add_dependencies(open62541-object open62541-code-generation)
