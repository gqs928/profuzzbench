+/* RFB 3.x and RDP/X.224 framing adapters. These extract client request
+ * boundaries from a testcase and normalize server handshake states. */
+static void append_protocol_region(region_t **regions, unsigned int *count,
+                                   unsigned int start, unsigned int length) {
+  if (length == 0) return;
+  *regions = (region_t *)ck_realloc(*regions, (*count + 1) * sizeof(region_t));
+  (*regions)[*count].start_byte = (int)start;
+  (*regions)[*count].end_byte = (int)(start + length - 1);
+  (*regions)[*count].modifiable = 1;
+  (*regions)[*count].state_sequence = NULL;
+  (*regions)[*count].state_count = 0;
+  (*count)++;
+}
+
+static void append_protocol_state(unsigned int **states, unsigned int *count,
+                                  unsigned int value) {
+  *states = (unsigned int *)ck_realloc(*states, (*count + 1) * sizeof(unsigned int));
+  (*states)[(*count)++] = value;
+}
+
+static unsigned int read_u16be(const unsigned char *buf) {
+  return ((unsigned int)buf[0] << 8) | buf[1];
+}
+
+static unsigned int read_u32be(const unsigned char *buf) {
+  return ((unsigned int)buf[0] << 24) | ((unsigned int)buf[1] << 16) |
+         ((unsigned int)buf[2] << 8) | (unsigned int)buf[3];
+}
+
+region_t* extract_requests_rfb(unsigned char* buf, unsigned int buf_size,
+                               unsigned int* region_count_ref) {
+  region_t *regions = NULL;
+  unsigned int count = 0, pos = 0, remain, message_type, length;
+  if (buf_size >= 12 && memcmp(buf, "RFB ", 4) == 0) {
+    append_protocol_region(&regions, &count, 0, 12);
+    pos = 12;
+    if (pos < buf_size) append_protocol_region(&regions, &count, pos++, 1); /* Security type */
+    if (pos < buf_size) append_protocol_region(&regions, &count, pos++, 1); /* ClientInit */
+  }
+  while (pos < buf_size) {
+    remain = buf_size - pos;
+    message_type = buf[pos];
+    switch (message_type) {
+      case 0: length = 20; break; /* SetPixelFormat */
+      case 1:
+        if (remain < 6) length = 0;
+        else length = 6 + 6 * read_u16be(buf + pos + 4);
+        break;
+      case 2:
+        if (remain < 4) length = 0;
+        else length = 4 + 4 * read_u16be(buf + pos + 2);
+        break;
+      case 3: length = 10; break; /* FramebufferUpdateRequest */
+      case 4: length = 8; break;  /* KeyEvent */
+      case 5: length = 6; break;  /* PointerEvent */
+      case 6:
+        if (remain < 8) length = 0;
+        else {
+          unsigned int payload_length = read_u32be(buf + pos + 4);
+          length = payload_length > remain - 8 ? 0 : 8 + payload_length;
+        }
+        break;
+      default: length = 1; break; /* Unknown/extension client message */
+    }
+    if (length == 0 || length > remain) {
+      append_protocol_region(&regions, &count, pos, remain);
+      break;
+    }
+    append_protocol_region(&regions, &count, pos, length);
+    pos += length;
+  }
+  if (count == 0 && buf_size > 0) append_protocol_region(&regions, &count, 0, buf_size);
+  *region_count_ref = count;
+  return regions;
+}
+
+unsigned int* extract_response_codes_rfb(unsigned char* buf, unsigned int buf_size,
+                                         unsigned int* state_count_ref) {
+  unsigned int *states = NULL, count = 0, pos = 0, remain, n, name_len;
+  char version[9];
+  append_protocol_state(&states, &count, 0);
+  if (buf_size >= 12 && memcmp(buf, "RFB ", 4) == 0) {
+    unsigned int major = 0, minor = 0;
+    memcpy(version, buf + 4, 8);
+    version[8] = '\0';
+    if (sscanf(version, "%3u.%3u", &major, &minor) == 2)
+      append_protocol_state(&states, &count, 0x10000000U | ((major & 0xffU) << 8) | (minor & 0xffU));
+    else append_protocol_state(&states, &count, 0x10000000U);
+    pos = 12;
+    remain = buf_size - pos;
+    if (remain >= 1) {
+      n = buf[pos];
+      if (n > 0 && n <= 32 && remain >= n + 1) {
+        append_protocol_state(&states, &count, 0x20000000U | n);
+        pos += n + 1;
+      }
+    }
+    remain = buf_size - pos;
+    if (remain >= 4 && read_u32be(buf + pos) <= 2) {
+      append_protocol_state(&states, &count, 0x30000000U | read_u32be(buf + pos));
+      pos += 4;
+    }
+    remain = buf_size - pos;
+    if (remain >= 24) {
+      name_len = read_u32be(buf + pos + 20);
+      append_protocol_state(&states, &count, 0x40000000U | ((read_u16be(buf + pos) != 0 && read_u16be(buf + pos + 2) != 0) ? 1U : 0U));
+      if (name_len <= remain - 24) pos += 24 + name_len;
+      else pos = buf_size;
+    }
+    if (pos < buf_size) append_protocol_state(&states, &count, 0x50000000U | buf[pos]);
+  } else if (buf_size > 0) {
+    append_protocol_state(&states, &count, 0xF0000000U | buf[0]);
+  }
+  *state_count_ref = count;
+  return states;
+}
+
+region_t* extract_requests_rdp(unsigned char* buf, unsigned int buf_size,
+                               unsigned int* region_count_ref) {
+  region_t *regions = NULL;
+  unsigned int count = 0, pos = 0, length, remain;
+  while (pos < buf_size) {
+    remain = buf_size - pos;
+    if (remain < 4 || buf[pos] != 0x03 || buf[pos + 1] != 0x00) {
+      append_protocol_region(&regions, &count, pos, remain);
+      break;
+    }
+    length = read_u16be(buf + pos + 2);
+    if (length < 4 || length > remain) {
+      append_protocol_region(&regions, &count, pos, remain);
+      break;
+    }
+    append_protocol_region(&regions, &count, pos, length);
+    pos += length;
+  }
+  *region_count_ref = count;
+  return regions;
+}
+
+unsigned int* extract_response_codes_rdp(unsigned char* buf, unsigned int buf_size,
+                                         unsigned int* state_count_ref) {
+  unsigned int *states = NULL, count = 0, pos = 0, remain, length, li, x224, state;
+  append_protocol_state(&states, &count, 0);
+  while (pos < buf_size) {
+    remain = buf_size - pos;
+    if (remain < 4 || buf[pos] != 0x03 || buf[pos + 1] != 0x00) {
+      append_protocol_state(&states, &count, 0xF0000000U | buf[pos]);
+      break;
+    }
+    length = read_u16be(buf + pos + 2);
+    if (length < 4 || length > remain) {
+      append_protocol_state(&states, &count, 0xE0000000U | length);
+      break;
+    }
+    if (length >= 6) {
+      li = buf[pos + 4];
+      x224 = buf[pos + 5];
+      state = 0x10000000U | ((li & 0xffU) << 8) | x224;
+      if (x224 == 0xD0 && length >= 19 && buf[pos + 11] == 0x02)
+        state = 0x20000000U | read_u32be(buf + pos + 15); /* RDP_NEG_RSP selected protocol */
+      else if (x224 == 0xF0 && length >= 8)
+        state = 0x30000000U | buf[pos + 7]; /* X.224 data / MCS PDU */
+      append_protocol_state(&states, &count, state);
+    }
+    pos += length;
+  }
+  *state_count_ref = count;
+  return states;
+}
