server default {
	listen {
		type = auth
		ipaddr = 127.0.0.1
		port = 1812
	}

	listen {
		type = acct
		ipaddr = 127.0.0.1
		port = 1813
	}

	listen {
		type = auth+acct
		ipaddr = 127.0.0.1
		port = 1812
		proto = tcp
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 5
		}
	}

	authorize {
		files
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
	}

	accounting {
		detail
	}
}
