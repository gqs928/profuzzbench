compatibility_level = 3.11
myhostname = smtp.fuzz.invalid
mydomain = fuzz.invalid
myorigin = $mydomain
mydestination = $myhostname, localhost.$mydomain, localhost, $mydomain
local_recipient_maps =
inet_interfaces = 127.0.0.1
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
smtpd_banner = $myhostname ESMTP
smtpd_helo_required = no
smtpd_client_restrictions = permit_mynetworks, reject
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
disable_vrfy_command = no
local_transport = discard:
default_transport = discard:
import_environment = MAIL_CONFIG MAIL_DEBUG MAIL_VERBOSE TZ LANG LC_ALL GCOV_PREFIX GCOV_PREFIX_STRIP
maillog_file = /dev/stdout
