FROM ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214

ARG DEBIAN_FRONTEND=noninteractive
ARG MAKE_OPT=-j2
ARG UBUNTU_SNAPSHOT=20260928T000000Z
ARG AFLNET_REF=0f51f9edf837c2f3d8f0ea98dc3b6c19b4562732
ARG AFLNET_SHA256=251f24bf2dddb8118eab56ef2b90c92b06f67c096c62543659eaaf31a31d955d
ARG COURIER_IMAP_SHA256=33827a707a14c155e858253e6aa82d7483d12c33bd09edbe4c3dd520dd13fd7f
ARG COURIER_AUTHLIB_SHA256=8629a3af9a169fc64e9f8fd6aafd320ba42c2443db15bf97e9f6076fe6dda618
ARG COURIER_UNICODE_SHA256=0aed2349c5b62de0d33ccf8c23527aae41daf95a03c8054c88de4faef8da8a08

ENV DEBIAN_FRONTEND=noninteractive AFLNET=/opt/aflnet AFL_PATH=/opt/aflnet AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1 AFL_SKIP_CPUFREQ=1 AFL_NO_AFFINITY=1
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt,sharing=locked rm -f /etc/apt/apt.conf.d/docker-clean && apt-get update -o Acquire::Retries=5 && apt-get install -y -o Acquire::Retries=5 --no-install-recommends ca-certificates && sed -i -E "s#https?://(archive|security)\\.ubuntu\\.com/ubuntu/?#https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/#g" /etc/apt/sources.list && apt-get update -o Acquire::Retries=5 && apt-get install -y -o Acquire::Retries=5 --no-install-recommends autoconf automake bison build-essential ca-certificates clang flex g++ gcc gcovr gettext git graphviz graphviz-dev libdb-dev libgcrypt20-dev libgdbm-dev libidn2-dev libltdl-dev libpam0g-dev libpcre2-dev libssl-dev libtool libtool-bin libwrap0-dev llvm llvm-dev make perl pkg-config python3 python3-minimal expect zlib1g-dev && rm -rf /var/lib/apt/lists/*

COPY source/aflnet-0f51f9edf837c2f3d8f0ea98dc3b6c19b4562732.tar.gz /tmp/aflnet.tar.gz
COPY source/courier-imap-6.0.7.tar.bz2 /tmp/courier-imap.tar.bz2
COPY source/courier-authlib-0.73.2.tar.bz2 /tmp/courier-authlib.tar.bz2
COPY source/courier-unicode-2.6.0.tar.bz2 /tmp/courier-unicode.tar.bz2
COPY aflnet-pop3.patch courier-authlib-compat.patch pop3_aflnet.c parser-test.c courier-runner.c /tmp/
COPY prepare_seeds.py /tmp/prepare_seeds.py
COPY source-checksums.sha256 /opt/benchmark/source-checksums.sha256
COPY pop3.dict imap.dict reset-maildir.sh protocol_smoke.py imap_protocol_smoke.py /opt/benchmark/
COPY seeds/ /opt/benchmark/seeds/

RUN set -eu; echo "${AFLNET_SHA256}  /tmp/aflnet.tar.gz" | sha256sum -c -; echo "${COURIER_IMAP_SHA256}  /tmp/courier-imap.tar.bz2" | sha256sum -c -; echo "${COURIER_AUTHLIB_SHA256}  /tmp/courier-authlib.tar.bz2" | sha256sum -c -; echo "${COURIER_UNICODE_SHA256}  /tmp/courier-unicode.tar.bz2" | sha256sum -c -; mkdir -p "${AFLNET}" /tmp/courier-unicode /tmp/courier-authlib /tmp/courier-imap; tar -xzf /tmp/aflnet.tar.gz -C "${AFLNET}"; tar -xjf /tmp/courier-unicode.tar.bz2 -C /tmp/courier-unicode --strip-components=1; tar -xjf /tmp/courier-authlib.tar.bz2 -C /tmp/courier-authlib --strip-components=1; tar -xjf /tmp/courier-imap.tar.bz2 -C /tmp/courier-imap --strip-components=1; sed -i 's/\r$//' "${AFLNET}"/Makefile "${AFLNET}"/aflnet.h "${AFLNET}"/afl-fuzz.c "${AFLNET}"/afl-replay.c "${AFLNET}"/aflnet-replay.c; cp /tmp/pop3_aflnet.c "${AFLNET}/pop3_aflnet.c"; git -C "${AFLNET}" apply --check /tmp/aflnet-pop3.patch; git -C "${AFLNET}" apply /tmp/aflnet-pop3.patch; read -r -a make_args <<< "${MAKE_OPT}"; AFL_NO_X86=1 make -C "${AFLNET}" all "${make_args[@]}"; AFL_NO_X86=1 make -C "${AFLNET}/llvm_mode" "${make_args[@]}"; cc -O2 -Wall -Wextra -Werror -I"${AFLNET}" /tmp/parser-test.c "${AFLNET}/pop3_aflnet.o" -o /tmp/pop3-parser-test; /tmp/pop3-parser-test; python3 /tmp/prepare_seeds.py /tmp/pop3-generated --username fuzzuser --password resp-benchmark-pass --manifest /tmp/pop3-generated-manifest.json; diff -r /opt/benchmark/seeds/pop3 /tmp/pop3-generated; cmp /opt/benchmark/seeds/pop3-seed-manifest.json /tmp/pop3-generated-manifest.json; test -x "${AFLNET}/afl-fuzz"; test -x "${AFLNET}/afl-clang-fast"; test -x "${AFLNET}/afl-clang-fast++"

RUN set -eu; cd /tmp/courier-authlib; patch --dry-run -p1 < /tmp/courier-authlib-compat.patch; patch -p1 < /tmp/courier-authlib-compat.patch; groupadd --gid 1100 courier; useradd --uid 1100 --gid 1100 --create-home --shell /usr/sbin/nologin courier; groupadd --gid 1101 fuzzuser; useradd --uid 1101 --gid 1101 --create-home --shell /usr/sbin/nologin fuzzuser; cd /tmp/courier-unicode; ./configure --prefix=/usr/local; make -j2; make install; ldconfig; cd /tmp/courier-authlib; PATH="/usr/local/bin:${PATH}" ./configure --prefix=/usr/local --with-mailuser=courier --with-mailgroup=courier --with-authuserdb; make -j2; make install; make install-configure; ldconfig

RUN set -eu; test -f /usr/local/etc/authlib/authdaemonrc; sed -i 's/^authmodulelist=.*/authmodulelist="authuserdb"/' /usr/local/etc/authlib/authdaemonrc; sed -i 's#^authdaemonvar=.*#authdaemonvar="/usr/local/var/authdaemon"#' /usr/local/etc/authlib/authdaemonrc; mkdir -p /usr/local/var/authdaemon; chown courier:courier /usr/local/var/authdaemon; /usr/local/sbin/userdb fuzzuser set home=/home/fuzzuser uid=1101 gid=1101; printf '%s\n' 'resp-benchmark-pass' | /usr/local/sbin/userdbpw -md5 | /usr/local/sbin/userdb fuzzuser set systempw; /usr/local/sbin/makeuserdb; mkdir -p /opt/benchmark/maildir-seed/{cur,new,tmp}; printf 'From: bench@example.invalid\r\nTo: fuzzuser@localhost\r\nSubject: Courier benchmark seed\r\nMessage-ID: <courier-benchmark-1@example.invalid>\r\n\r\nA fixed message for deterministic POP3 and IMAP retrieval.\r\n' > /opt/benchmark/maildir-seed/new/1710000000.M000001P1Q1.benchmark; chmod -R a+rX /opt/benchmark/maildir-seed; chown -R courier:courier /usr/local/var/authdaemon

COPY courier-clang-ctad.patch courier-clang10-tests.patch courier-clang10-maildirkw.patch /tmp/
RUN set -eu; patch --dry-run -p1 -d /tmp/courier-imap < /tmp/courier-authlib-compat.patch; patch -p1 -d /tmp/courier-imap < /tmp/courier-authlib-compat.patch; for variant in reference afl gcov; do cp -a /tmp/courier-imap "/tmp/courier-imap-${variant}"; prefix="/opt/courier-${variant}"; read -r -a make_args <<< "${MAKE_OPT}"; if [[ "${variant}" == afl ]]; then patch --dry-run -p1 -d "/tmp/courier-imap-${variant}" < /tmp/courier-clang-ctad.patch; patch -p1 -d "/tmp/courier-imap-${variant}" < /tmp/courier-clang-ctad.patch; patch --dry-run -p1 -d "/tmp/courier-imap-${variant}" < /tmp/courier-clang10-tests.patch; patch -p1 -d "/tmp/courier-imap-${variant}" < /tmp/courier-clang10-tests.patch; patch --dry-run -p1 -d "/tmp/courier-imap-${variant}" < /tmp/courier-clang10-maildirkw.patch; patch -p1 -d "/tmp/courier-imap-${variant}" < /tmp/courier-clang10-maildirkw.patch; (cd "/tmp/courier-imap-${variant}" && AFL_USE_ASAN=1 CC="${AFLNET}/afl-clang-fast" CXX="${AFLNET}/afl-clang-fast++" CFLAGS='-O1 -g -fno-omit-frame-pointer' CXXFLAGS='-O1 -g -fno-omit-frame-pointer' ./configure --prefix="${prefix}" --with-db=gdbm --with-notice=unicode && AFL_USE_ASAN=1 make "${make_args[@]}" && make install && make install-configure); elif [[ "${variant}" == gcov ]]; then (cd "/tmp/courier-imap-${variant}" && CC=cc CXX=g++ CFLAGS='-O0 -g --coverage' CXXFLAGS='-O0 -g --coverage' LDFLAGS='--coverage' LIBS='-lstdc++' ./configure --prefix="${prefix}" --with-db=gdbm --with-notice=unicode && make "${make_args[@]}" && make install && make install-configure); else (cd "/tmp/courier-imap-${variant}" && CC=cc CXX=g++ CFLAGS='-O2 -g' CXXFLAGS='-O2 -g' ./configure --prefix="${prefix}" --with-db=gdbm --with-notice=unicode && make "${make_args[@]}" && make install && make install-configure); fi; sed -i 's/^PORT=.*/PORT=1110/; s/^ADDRESS=.*/ADDRESS=127.0.0.1/' "${prefix}/etc/pop3d"; sed -i 's/^POP3DSTART=.*/POP3DSTART=YES/; s#^MAILDIRPATH=.*#MAILDIRPATH=Maildir#' "${prefix}/etc/pop3d"; sed -i 's/^PORT=.*/PORT=1143/; s/^ADDRESS=.*/ADDRESS=127.0.0.1/' "${prefix}/etc/imapd"; sed -i 's#^MAILDIRPATH=.*#MAILDIRPATH=Maildir#' "${prefix}/etc/imapd"; touch "${prefix}/etc/imapaccess"; (cd "${prefix}/etc" && "${prefix}/bin/makeimapaccess"); test -x "${prefix}/libexec/couriertcpd"; test -x "${prefix}/sbin/pop3login"; test -x "${prefix}/sbin/imaplogin"; test -x "${prefix}/bin/pop3d"; test -x "${prefix}/bin/imapd"; done

RUN AFL_USE_ASAN=1 "${AFLNET}/afl-clang-fast" -O1 -g -Wall -Wextra -Werror -fno-omit-frame-pointer /tmp/courier-runner.c -o /opt/benchmark/courier-runner

RUN set -eu; sha256sum /opt/benchmark/seeds/pop3/*.pop3 > /opt/benchmark/pop3-seed-checksums.sha256; sha256sum /opt/benchmark/seeds/imap/* > /opt/benchmark/imap-seed-checksums.sha256; { printf 'base_image=%s\n' 'ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214'; printf 'ubuntu_snapshot=%s\n' "${UBUNTU_SNAPSHOT}"; printf 'courier_imap_version=%s\n' '6.0.7'; printf 'courier_authlib_version=%s\n' '0.73.2'; printf 'courier_unicode_version=%s\n' '2.6.0'; printf 'aflnet_ref=%s\n' "${AFLNET_REF}"; printf 'aflnet_archive_sha256=%s\n' "${AFLNET_SHA256}"; printf 'courier_imap_archive_sha256=%s\n' "${COURIER_IMAP_SHA256}"; printf 'courier_authlib_archive_sha256=%s\n' "${COURIER_AUTHLIB_SHA256}"; printf 'courier_authlib_compat_patch_sha256='; sha256sum /tmp/courier-authlib-compat.patch | cut -d ' ' -f1; printf 'courier_clang_ctad_patch_sha256='; sha256sum /tmp/courier-clang-ctad.patch | cut -d ' ' -f1; printf 'courier_clang10_tests_patch_sha256='; sha256sum /tmp/courier-clang10-tests.patch | cut -d ' ' -f1; printf 'courier_clang10_maildirkw_patch_sha256='; sha256sum /tmp/courier-clang10-maildirkw.patch | cut -d ' ' -f1; printf 'courier_unicode_archive_sha256=%s\n' "${COURIER_UNICODE_SHA256}"; printf 'aflnet_pop3_patch_sha256='; sha256sum /tmp/aflnet-pop3.patch | cut -d ' ' -f1; printf 'pop3_adapter_sha256='; sha256sum /tmp/pop3_aflnet.c | cut -d ' ' -f1; printf 'parser_test_sha256='; sha256sum /tmp/parser-test.c | cut -d ' ' -f1; printf 'courier_runner_sha256='; sha256sum /tmp/courier-runner.c | cut -d ' ' -f1; for variant in reference afl gcov; do printf 'courier_%s_pop3d=' "${variant}"; strings "/opt/courier-${variant}/bin/pop3d" | grep -m 1 'Courier-IMAP' || true; done; cc --version | sed -n '1p'; clang --version | sed -n '1p'; dpkg-query -W -f='%{binary:Package}=%{Version}\n' build-essential clang graphviz-dev libgdbm-dev libidn2-dev libltdl-dev libssl-dev llvm llvm-dev make python3 | sort; } > /opt/benchmark/build-versions.txt

ENV PATH=/opt/aflnet:/opt/courier-reference/bin:/opt/courier-reference/sbin:/opt/courier-reference/libexec:${PATH} COURIER_REFERENCE_PREFIX=/opt/courier-reference COURIER_AFL_PREFIX=/opt/courier-afl
WORKDIR /opt/benchmark
EXPOSE 1110/tcp 1143/tcp
