ARG BASE_IMAGE=profuzzbench/courier-aflnet:6.0.7-base
FROM ${BASE_IMAGE}

COPY aflnet-imap.patch imap-parser-test.c /tmp/
RUN set -eu; patch --dry-run --batch -p1 -d /opt/aflnet < /tmp/aflnet-imap.patch; patch --batch -p1 -d /opt/aflnet < /tmp/aflnet-imap.patch; PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin /usr/bin/cc -Wall -Wextra -Werror -I/opt/aflnet /opt/aflnet/imap_aflnet.c /tmp/imap-parser-test.c -o /tmp/imap-parser-test; /tmp/imap-parser-test; PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin /usr/bin/make -C /opt/aflnet CC=/usr/bin/cc afl-fuzz afl-replay aflnet-replay; test -x /opt/aflnet/afl-fuzz; test -x /opt/aflnet/afl-replay; test -x /opt/aflnet/aflnet-replay
RUN set -eu; printf 'aflnet_imap_patch_sha256=' >> /opt/benchmark/build-versions.txt; sha256sum /tmp/aflnet-imap.patch | cut -d ' ' -f1 >> /opt/benchmark/build-versions.txt; printf 'imap_adapter_sha256=' >> /opt/benchmark/build-versions.txt; sha256sum /opt/aflnet/imap_aflnet.c | cut -d ' ' -f1 >> /opt/benchmark/build-versions.txt; printf 'imap_parser_test_sha256=' >> /opt/benchmark/build-versions.txt; sha256sum /tmp/imap-parser-test.c | cut -d ' ' -f1 >> /opt/benchmark/build-versions.txt

ENV PATH=/opt/aflnet:/opt/courier-reference/bin:/opt/courier-reference/sbin:/opt/courier-reference/libexec:${PATH} COURIER_REFERENCE_PREFIX=/opt/courier-reference COURIER_AFL_PREFIX=/opt/courier-afl
WORKDIR /opt/benchmark
EXPOSE 1110/tcp 1143/tcp
