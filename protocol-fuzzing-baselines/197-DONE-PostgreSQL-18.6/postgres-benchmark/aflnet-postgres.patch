diff --git a/afl-fuzz.c b/afl-fuzz.c
index 8023451..a615cfd 100644
--- a/afl-fuzz.c
+++ b/afl-fuzz.c
@@ -384,6 +384,9 @@ u8 poll_wait = 0;
 u8 server_wait = 0;
 u8 socket_timeout = 0;
 u8 protocol_selected = 0;
+static u8 postgres_protocol_mode = 0;
+static u8 postgres_trace_snapshot_valid = 0;
+static u8 postgres_trace_snapshot[MAP_SIZE];
 u8 terminate_child = 0;
 u8 corpus_read_or_sync = 0;
 u8 state_aware_mode = 0;
@@ -1059,7 +1062,10 @@ int send_over_network()
   }
 
   //retrieve early server response if needed
-  if (net_recv(sockfd, timeout, poll_wait_msecs, &response_buf, &response_buf_size)) goto HANDLE_RESPONSES;
+  if (postgres_protocol_mode) {
+    /* PostgreSQL 等待客户端 StartupMessage；服务端启动轨迹不计入协议覆盖。 */
+    memset(trace_bits, 0, MAP_SIZE);
+  } else if (net_recv(sockfd, timeout, poll_wait_msecs, &response_buf, &response_buf_size)) goto HANDLE_RESPONSES;
 
   //write the request messages
   kliter_t(lms) *it;
@@ -1108,6 +1114,12 @@ HANDLE_RESPONSES:
 
   close(sockfd);
 
+  if (postgres_protocol_mode) {
+    /* 在关闭服务端前保存请求处理覆盖，排除后台进程与关机轨迹。 */
+    memcpy(postgres_trace_snapshot, trace_bits, MAP_SIZE);
+    postgres_trace_snapshot_valid = 1;
+  }
+
   if (likely_buggy && false_negative_reduction) return 0;
 
   if (terminate_child && (child_pid > 0)) kill(child_pid, SIGTERM);
@@ -3131,6 +3143,7 @@ static u8 run_target(char** argv, u32 timeout) {
   u32 tb4;
 
   child_timed_out = 0;
+  postgres_trace_snapshot_valid = 0;
 
   /* After this memset, trace_bits[] are effectively volatile, so we
      must prevent any earlier operations from venturing into that
@@ -3272,6 +3285,11 @@ static u8 run_target(char** argv, u32 timeout) {
 
   }
 
+  if (postgres_protocol_mode && postgres_trace_snapshot_valid) {
+    memcpy(trace_bits, postgres_trace_snapshot, MAP_SIZE);
+    postgres_trace_snapshot_valid = 0;
+  }
+
   if (!WIFSTOPPED(status)) child_pid = 0;
 
   getitimer(ITIMER_REAL, &it);
@@ -8995,6 +9013,10 @@ int main(int argc, char** argv) {
         } else if (!strcmp(optarg, "HTTP")) {
           extract_requests = &extract_requests_http;
           extract_response_codes = &extract_response_codes_http;
+        } else if (!strcmp(optarg, "POSTGRES")) {
+          extract_requests = &extract_requests_postgres;
+          extract_response_codes = &extract_response_codes_postgres;
+          postgres_protocol_mode = 1;
         } else {
           FATAL("%s protocol is not supported yet!", optarg);
         }
