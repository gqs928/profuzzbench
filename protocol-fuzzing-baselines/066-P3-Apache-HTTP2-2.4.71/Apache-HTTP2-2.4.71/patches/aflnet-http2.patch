+
+/* Track HTTP/2 response frame type and flags as stable protocol states. The
+ * first word remains the initial state, matching the other AFLNet parsers. */
+unsigned int* extract_response_codes_http2(unsigned char* buf, unsigned int buf_size, unsigned int* state_count_ref)
+{
+  unsigned int offset = 0;
+  unsigned int state_count = 1;
+  unsigned int max_states = buf_size / 9 + 1;
+  unsigned int *state_sequence = (unsigned int *)ck_alloc(max_states * sizeof(unsigned int));
+  state_sequence[0] = 0;
+
+  while (buf_size - offset >= 9) {
+    unsigned int frame_len = ((unsigned int)buf[offset] << 16) |
+                             ((unsigned int)buf[offset + 1] << 8) |
+                             (unsigned int)buf[offset + 2];
+    unsigned int frame_size = frame_len + 9;
+    unsigned int frame_type = buf[offset + 3];
+    unsigned int frame_flags = buf[offset + 4];
+    unsigned int state;
+
+    if (frame_len > buf_size - offset - 9) break;
+    state = 0x48000000u | (frame_type << 16) | frame_flags;
+    state_sequence[state_count++] = state;
+    offset += frame_size;
+  }
+
+  *state_count_ref = state_count;
+  return state_sequence;
+}
 
