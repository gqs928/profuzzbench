+/* HTTP/2 messages are frames, not CRLF-delimited text lines. Preserve the
+ * preface and a valid initial SETTINGS frame as one region, then split later
+ * complete frames by their 24-bit length field. Keep malformed tails intact. */
+static void append_http2_region(region_t **regions_ref, unsigned int *count_ref,
+                                unsigned int *capacity_ref, unsigned int start,
+                                unsigned int end)
+{
+  region_t *region;
+  if (*count_ref == *capacity_ref) {
+    *capacity_ref = *capacity_ref ? *capacity_ref * 2 : 8;
+    *regions_ref = (region_t *)ck_realloc(*regions_ref, *capacity_ref * sizeof(region_t));
+  }
+  region = &(*regions_ref)[(*count_ref)++];
+  region->start_byte = start;
+  region->end_byte = end;
+  region->modifiable = 1;
+  region->state_sequence = NULL;
+  region->state_count = 0;
+}
+
+region_t* extract_requests_http2(unsigned char* buf, unsigned int buf_size, unsigned int* region_count_ref)
+{
+  static const unsigned char preface[] = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";
+  const unsigned int preface_len = sizeof(preface) - 1;
+  unsigned int offset = 0;
+  unsigned int region_count = 0;
+  unsigned int region_capacity = 0;
+  region_t *regions = NULL;
+
+  if (buf_size == 0) {
+    *region_count_ref = 0;
+    return NULL;
+  }
+
+  if (buf_size >= preface_len && memcmp(buf, preface, preface_len) == 0) {
+    offset = preface_len;
+    if (buf_size - offset >= 9) {
+      unsigned int frame_len = ((unsigned int)buf[offset] << 16) |
+                               ((unsigned int)buf[offset + 1] << 8) |
+                               (unsigned int)buf[offset + 2];
+      unsigned int stream_id = ((unsigned int)(buf[offset + 5] & 0x7f) << 24) |
+                               ((unsigned int)buf[offset + 6] << 16) |
+                               ((unsigned int)buf[offset + 7] << 8) |
+                               (unsigned int)buf[offset + 8];
+      if (buf[offset + 3] == 4 && buf[offset + 4] == 0 && stream_id == 0 &&
+          frame_len % 6 == 0 && frame_len <= buf_size - offset - 9) {
+        offset += frame_len + 9;
+        append_http2_region(&regions, &region_count, &region_capacity, 0, offset - 1);
+      } else {
+        append_http2_region(&regions, &region_count, &region_capacity, 0, preface_len - 1);
+      }
+    } else {
+      append_http2_region(&regions, &region_count, &region_capacity, 0, preface_len - 1);
+    }
+  }
+
+  while (offset < buf_size) {
+    unsigned int remaining = buf_size - offset;
+    unsigned int frame_len;
+    unsigned int frame_size;
+
+    if (remaining < 9) break;
+    frame_len = ((unsigned int)buf[offset] << 16) |
+                ((unsigned int)buf[offset + 1] << 8) |
+                (unsigned int)buf[offset + 2];
+    if (frame_len > remaining - 9) break;
+    frame_size = frame_len + 9;
+
+    append_http2_region(&regions, &region_count, &region_capacity, offset, offset + frame_size - 1);
+    offset += frame_size;
+  }
+
+  if (offset < buf_size) {
+    append_http2_region(&regions, &region_count, &region_capacity, offset, buf_size - 1);
+  }
+
+  *region_count_ref = region_count;
+  return regions;
+}
