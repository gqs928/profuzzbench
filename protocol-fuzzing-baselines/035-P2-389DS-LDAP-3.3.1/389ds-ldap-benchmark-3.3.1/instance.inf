[general]
config_version = 2
full_machine_name = localhost
selinux = False
start = True

[slapd]
instance_name = benchmark
port = 3389
secure_port = 3636
root_dn = cn=Directory Manager
root_password = DirectoryManagerPassword
user = dirsrv
group = dirsrv

[backend-userroot]
suffix = dc=example,dc=com
sample_entries = no
