# Fast compatibility layer for the already-built quiche 0.30.0 image.
# Clean/reproducible builds use Dockerfile, which applies the same patch.
FROM cloudflare-quiche-aflnet-bench:0.30.0

COPY patches/aflnet-quic.patch /tmp/aflnet-quic.patch
COPY patches/expand-aflnet-map.py /tmp/expand-aflnet-map.py
COPY run.sh /opt/benchmark/run.sh
COPY build-info.sh /opt/benchmark/build-info.sh
RUN rm -rf /opt/aflnet \
    && mkdir -p /opt/aflnet \
    && tar -xzf /opt/benchmark/source/aflnet-0f51f9edf837c2f3d8f0ea98dc3b6c19b4562732.tar.gz -C /opt/aflnet \
    && patch --directory=/opt/aflnet --strip=1 --fuzz=0 --input=/tmp/aflnet-quic.patch \
    && python3 /tmp/expand-aflnet-map.py /opt/aflnet/config.h \
    && make -C /opt/aflnet clean all

ENV AFL_MAP_SIZE=262144 \
    AFL_OLD_FORKSERVER=1
