ARG BASE_IMAGE=apache-kafka-fuzz-bench-base:20261014
FROM ${BASE_IMAGE}

ARG BASE_IMAGE_ID
USER ubuntu

RUN test "$(sed -n 's/^kafka_version=//p' /home/ubuntu/experiments/build-versions.txt | head -n1)" = 4.4.0 || { echo "overlay base must contain Kafka 4.4.0" >&2; exit 65; }

COPY --chown=ubuntu:ubuntu kafka_jvm_agent.c aflnet-kafka-fuzz.patch start-kafka.sh \
     source-lock.json source-checksums.sha256 /tmp/

# 复用已构建的 Kafka 二进制，只重编 AFLNet C 文件和轻量 JVMTI 代理。
RUN set -eu; \
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"; \
    cd /home/ubuntu/aflnet; \
    patch --dry-run -R -p1 < /tmp/aflnet-kafka-fuzz.patch; \
    cd /home/ubuntu/experiments; \
    build_cpu="$(awk -F: '/^Cpus_allowed_list:/ { gsub(/[[:space:]]/, "", $2); split($2, allowed, /[-,]/); print allowed[1] }' /proc/self/status)"; \
    test -n "${build_cpu}"; \
    taskset -c "${build_cpu}" nice -n 19 env AFL_NO_X86=1 \
      make -C /home/ubuntu/aflnet afl-fuzz; \
    JAVA_HOME_REAL="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")"; \
    cc -shared -fPIC -O2 -Wall -Wextra -Werror -pthread \
      -I"${JAVA_HOME_REAL}/include" -I"${JAVA_HOME_REAL}/include/linux" \
      -o /home/ubuntu/agents/libkafka_afl_agent.so /tmp/kafka_jvm_agent.c; \
    cp /tmp/kafka_jvm_agent.c /home/ubuntu/experiments/kafka_jvm_agent.c; \
    cp /tmp/aflnet-kafka-fuzz.patch /home/ubuntu/experiments/aflnet-kafka-fuzz.patch; \
    cp /tmp/start-kafka.sh /home/ubuntu/experiments/start-kafka.sh; \
    cp /tmp/source-lock.json /home/ubuntu/experiments/source-lock.json; \
    cp /tmp/source-checksums.sha256 /home/ubuntu/experiments/source-checksums.sha256; \
    (cd /home/ubuntu/experiments && sha256sum -c source-checksums.sha256); \
    agent_hash="$(sha256sum /home/ubuntu/agents/libkafka_afl_agent.so | cut -d ' ' -f1)"; \
    fuzz_patch_hash="$(sha256sum /tmp/aflnet-kafka-fuzz.patch | cut -d ' ' -f1)"; \
    sed -i \
      -e "s/^jvm_agent_sha256=.*/jvm_agent_sha256=${agent_hash}/" \
      -e "s/^aflnet_kafka_fuzz_patch_sha256=.*/aflnet_kafka_fuzz_patch_sha256=${fuzz_patch_hash}/" \
      /home/ubuntu/experiments/build-versions.txt; \
    printf 'kafka_jvm_coverage=KafkaApis-request-handler-method-presence-bitmap;call-frequency-not-counted\n' \
      >> /home/ubuntu/experiments/build-versions.txt; \
    printf 'kafka_child_termination=SIGTERM;graceful-exit\n' \
      >> /home/ubuntu/experiments/build-versions.txt; \
    printf 'source_lock_sha256=%s\n' "$(sha256sum /home/ubuntu/experiments/source-lock.json | cut -d ' ' -f1)" \
      >> /home/ubuntu/experiments/build-versions.txt; \
    printf 'overlay_base_image_id=%s\n' "${BASE_IMAGE_ID}" \
      >> /home/ubuntu/experiments/build-versions.txt; \
    test -s /home/ubuntu/agents/libkafka_afl_agent.so

WORKDIR /home/ubuntu/experiments
