--- a/afl-fuzz.c
+++ b/afl-fuzz.c
@@ -1123,10 +1123,15 @@ int send_over_network()
   if (terminate_child && (child_pid > 0)) kill(child_pid, SIGTERM);
 
   //give the server a bit more time to gracefully terminate
-  while(1) {
-    int status = kill(child_pid, 0);
-    if ((status != 0) && (errno == ESRCH)) break;
+  /* In no-forkserver mode run_target() is the parent responsible for
+     reaping child_pid immediately after this function returns. Waiting for
+     kill(pid, 0) to fail here deadlocks on the unreaped zombie. */
+  if (!dumb_mode && !no_forkserver) {
+    while(1) {
+      int status = kill(child_pid, 0);
+      if ((status != 0) && (errno == ESRCH)) break;
+    }
   }
 
   return 0;
 }
