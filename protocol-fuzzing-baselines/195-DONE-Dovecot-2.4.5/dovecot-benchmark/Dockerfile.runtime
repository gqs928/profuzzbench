ARG BASE_IMAGE=dovecot-imap-fuzz-base
FROM ${BASE_IMAGE}

COPY --chmod=0755 dovecot-root-launcher-runtime.sh /usr/local/sbin/dovecot-root-launcher
COPY --chmod=0755 clean-maildir-runtime.sh /usr/local/sbin/dovecot-clean-maildir
COPY --chmod=0440 sudoers.dovecot-benchmark-runtime /etc/sudoers.d/dovecot-benchmark

USER root
RUN visudo -cf /etc/sudoers.d/dovecot-benchmark
USER ubuntu
