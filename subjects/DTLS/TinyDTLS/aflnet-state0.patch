diff --git a/afl-fuzz.c b/afl-fuzz.c
index 6a04d12..a212db0 100644
--- a/afl-fuzz.c
+++ b/afl-fuzz.c
@@ -882,2 +882,28 @@ void update_state_aware_variables(struct queue_entry *q, u8 dry_run)

+  // A valid seed may produce no server response. In that case the parsed
+  // sequence contains only state 0, so the loop above does not create it.
+  // Register the initial IPSM node and state before annotating the seed.
+  k = kh_get(hms, khms_states, 0);
+  if (k == kh_end(khms_states)) {
+    Agnode_t *initial_node = agnode(ipsm, "0", TRUE);
+    if (dry_run) agset(initial_node, "color", "blue");
+
+    state_info_t *initial_state = (state_info_t *) ck_alloc(sizeof(state_info_t));
+    initial_state->id = 0;
+    initial_state->is_covered = 1;
+    initial_state->paths = 0;
+    initial_state->paths_discovered = 0;
+    initial_state->selected_times = 0;
+    initial_state->fuzzs = 0;
+    initial_state->score = 1;
+    initial_state->selected_seed_index = 0;
+    initial_state->seeds = NULL;
+    initial_state->seeds_count = 0;
+
+    k = kh_put(hms, khms_states, 0, &discard);
+    kh_value(khms_states, k) = initial_state;
+    state_ids = (u32 *) ck_realloc(state_ids, (state_ids_count + 1) * sizeof(u32));
+    state_ids[state_ids_count++] = 0;
+  }
+
   //Update others no matter the new seed leads to interesting state sequence or not
